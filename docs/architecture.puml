
@startuml
!theme aws-orange
left to right direction

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

title Architecture logicielle - Gestion de rendez-vous médicaux

actor "Patient / Médecin /\nAdministrateur" as User

package "Frontend - Angular" {
    component "Pages & Components" as Components
    component "Angular Services" as AngularServices
    component "Routing & Forms" as AngularUI

    AngularUI --> Components
    Components --> AngularServices
}

package "Backend - NestJS" {
    component "AppointmentsController" as Controller
    component "AppointmentsService" as Service
    component "AppointmentRepository" as Repository
    component "NotificationService" as NotificationService

    Controller --> Service
    Service --> Repository
    Service --> NotificationService
}

database "MySQL Database" as DB

component "TypeORM" as ORM

User --> AngularUI
AngularServices --> Controller : HTTP / REST API
Repository --> ORM
ORM --> DB : SQL

cloud "External Notification\nProvider" as Provider
NotificationService --> Provider : API

note right of Service
  Business rules:
  - Availability verification
  - Reservation management
  - Conflict handling
  - Cancellation management
end note

note bottom of DB
  Database constraints and
  transactions protect data
  consistency and prevent
  double bookings.
end note

@enduml
